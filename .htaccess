# ==============================================================================
# Vivadoxa Apache Server Configuration & Performance Engine
# Optimized for Ultra-Fast Search Engine & Generative AI Bot Indexing
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Standard AI Discovery Route: Support /.well-known/llms.txt
  RewriteRule ^\.well-known/llms\.txt$ llms.txt [L]

  # Don't rewrite calls to the backend API directory
  RewriteRule ^api/ - [L]

  # Don't rewrite requests for existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback for uploaded media stored in public/media/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(media/.+)$ public/$1 [L]

  # Fallback for uploaded media stored in dist/media/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(media/.+)$ dist/$1 [L]

  # Route all other URLs to the index.html SPA entrypoint
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 1. Gzip / Deflate Compression for Sub-50ms Response Time
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/markdown
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 2. Correct MIME Types & UTF-8 for AI Feeds
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/plain;charset=utf-8 .txt
  AddType text/markdown;charset=utf-8 .md
  AddType application/ld+json .jsonld
  AddType application/xml .xml
</IfModule>

# ------------------------------------------------------------------------------
# 3. Crawler & Cache Performance Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Global Crawl Directive for Search & AI Engines
  Header set X-Robots-Tag "all, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  Header set Content-Language "en-NG, en"

  # Caching for immutable static assets (1 year)
  <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|svg|woff2|woff|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Caching for scripts and styles (1 month)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # Revalidation for html, json, sitemap and llms.txt (fast updates for crawlers)
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 4. Browser Caching Rules via mod_expires
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ------------------------------------------------------------------------------
# 5. Security & Sensitive File Protection
# ------------------------------------------------------------------------------
<FilesMatch "^\.env|\.git|\.cpanel\.yml|\.mise\.toml">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
