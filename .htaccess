<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite calls to the backend API directory
  RewriteRule ^api/ - [L]

  # Don't rewrite requests for existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs to the index.html SPA entrypoint
  RewriteRule ^ index.html [L]
</IfModule>

# Protect sensitive files
<FilesMatch "^\.env|\.git|\.cpanel\.yml">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
